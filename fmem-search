#!/bin/bash
# fmem search wrapper for OpenClaw
# Provides unified search interface with fallback to keyword search

set -e

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="${FMEM_WORKSPACE:-/home/luis/.openclaw/workspace}"
MEMORY_DIR="$WORKSPACE/memory"
MEMORY_MD="$WORKSPACE/MEMORY.md"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Statistics
results_count=0
semantic_results=0
keyword_results=0

# Parse arguments
QUERY=""
TOP_K=5
QUIET=false
FORCE_SEMANTIC=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -k|--top-k)
            TOP_K="$2"
            shift 2
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --semantic)
            FORCE_SEMANTIC=true
            shift
            ;;
        --keyword)
            FORCE_SEMANTIC=false
            shift
            ;;
        -*)
            if [[ -z "$QUERY" ]]; then
                QUERY="$1"
            fi
            shift
            ;;
        *)
            if [[ -z "$QUERY" ]]; then
                QUERY="$1"
            fi
            shift
            ;;
    esac
done

# If no query provided, read from stdin
if [[ -z "$QUERY" ]]; then
    if [[ ! -t 0 ]]; then
        QUERY=$(cat)
    else
        echo -e "${YELLOW}Usage: fmem-search <query> [-k N] [--semantic|--keyword]${NC}"
        echo "  -k, --top-k N    Number of results (default: 5)"
        echo "  -q, --quiet      Suppress non-result output"
        echo "  --semantic       Force semantic search only"
        echo "  --keyword        Force keyword search only"
        echo ""
        echo "Examples:"
        echo "  fmem-search \"what did I work on\""
        echo "  fmem-search \"OpenClaw\" -k 10"
        echo "  echo \"my query\" | fmem-search"
        exit 0
    fi
fi

# Validate query
if [[ -z "$QUERY" || -z "$(echo "$QUERY" | tr -d '[:space:]')" ]]; then
    echo -e "${RED}Error: Query cannot be empty or whitespace only${NC}"
    exit 1
fi

# Function to log (only if not quiet)
log() {
    if [[ "$QUIET" == "false" ]]; then
        echo -e "$1"
    fi
}

# Function to perform keyword search
keyword_search() {
    local query="$1"
    local top_k="${2:-5}"
    
    log "${YELLOW}[Keyword Search]${NC} Query: '$query'"
    
    local results=()
    
    # Search MEMORY.md
    if [[ -f "$MEMORY_MD" ]]; then
        local matches
        matches=$(grep -in "$query" "$MEMORY_MD" 2>/dev/null | head -n "$top_k" || true)
        if [[ -n "$matches" ]]; then
            while IFS= read -r line; do
                results+=("$MEMORY_MD|$line")
            done <<< "$matches"
        fi
    fi
    
    # Search daily memory files
    if [[ -d "$MEMORY_DIR" ]]; then
        local md_files
        md_files=$(find "$MEMORY_DIR" -name "*.md" -type f 2>/dev/null | head -n "$top_k" || true)
        
        for file in $md_files; do
            local matches
            matches=$(grep -in "$query" "$file" 2>/dev/null | head -n "$((top_k - ${#results[@]}))" || true)
            if [[ -n "$matches" ]]; then
                while IFS= read -r line; do
                    results+=("$file|$line")
                done <<< "$matches"
            fi
        done
    fi
    
    # Return results count
    echo "${#results[@]}"
    
    # Output results if not quiet
    if [[ "$QUIET" == "false" ]] && [[ ${#results[@]} -gt 0 ]]; then
        echo ""
        echo "Keyword Search Results for: '$query'"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        local count=0
        for result in "${results[@]}"; do
            ((count++))
            local filepath="${result%%|*}"
            local content="${result#*|}"
            local line_num
            line_num=$(echo "$content" | cut -d: -f1)
            local line_content
            line_content=$(echo "$content" | cut -d: -f2-)
            
            echo ""
            echo "[$count] File: $filepath (line $line_num)"
            echo "    Context: $line_content"
        done
        echo ""
    fi
}

# Function to perform semantic search using fmem
semantic_search() {
    local query="$1"
    local top_k="${2:-5}"
    
    log "${GREEN}[Semantic Search]${NC} Query: '$query'"
    
    # Check if fmem.py exists
    if [[ ! -f "$SCRIPT_DIR/fmem.py" ]]; then
        log "${RED}Error: fmem.py not found at $SCRIPT_DIR${NC}"
        return 1
    fi
    
    # Run fmem search
    cd "$WORKSPACE"
    local output
    if output=$(python3 "$SCRIPT_DIR/fmem.py" search "$query" -k "$top_k" 2>&1); then
        # Output results
        echo "$output"
        
        # Extract result count from output
        results_count=$(echo "$output" | grep -oP '\d+(?= results)' | head -1 || echo "0")
        
        return 0
    else
        log "${YELLOW}Warning: Semantic search failed, falling back to keyword search${NC}"
        return 1
    fi
}

# Main execution
echo ""
echo "Search: '$QUERY' (top-$TOP_K)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Try semantic search first (unless forced keyword)
if [[ "$FORCE_SEMANTIC" == "false" ]]; then
    if semantic_search "$QUERY" "$TOP_K"; then
        semantic_results=1
    else
        keyword_search "$QUERY" "$TOP_K" > /dev/null
        keyword_results=$(keyword_search "$QUERY" "$TOP_K")
    fi
else
    # Force semantic search
    semantic_search "$QUERY" "$TOP_K" || keyword_search "$QUERY" "$TOP_K"
fi

# Fallback to keyword search if semantic failed or returned nothing
if [[ "$semantic_results" == "0" ]]; then
    if [[ "$QUIET" == "false" ]]; then
        echo ""
    fi
    keyword_search "$QUERY" "$TOP_K"
fi

# Summary
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [[ "$semantic_results" == "1" ]]; then
    log "${GREEN}✓ Semantic search completed${NC}"
else
    log "${YELLOW}ℹ Used keyword search only${NC}"
fi
